# Copy this file to .env and fill in real values.
# Never commit the actual .env file - it contains credentials.

# ---- IOP GPS API settings ----
IOPGPS_DOMAIN=https://open.iopgps.com/
IOPGPS_APP_ID=
IOPGPS_SECRET_KEY=

# ---- Our own API's authorization ----
# Comma-separated list of keys that end users must pass as "accesskey"
# to call our /api/live-stream endpoint.
API_ACCESS_KEYS=

# ---- Dashcam operation defaults ----
DEFAULT_CHANNEL=1
DEFAULT_STREAM_PROTOCOL=http
REQUEST_TIMEOUT=15

# ---- Cache TTLs (seconds) ----
TOKEN_TTL_BUFFER_SECONDS=120
STREAM_URL_TTL_SECONDS=7200

# ---- MongoDB ----
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=dashcam_service
MONGO_TOKEN_COLLECTION=iopgps_tokens
MONGO_LOG_COLLECTION=api_call_logs
